generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Суммы везде хранятся в копейках (RUB), если не сказано иначе.

model User {
  id        Int       @id @default(autoincrement())
  tgId      BigInt    @unique
  username  String?
  firstName String?
  balance   Int       @default(0)
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())
  orders    Order[]
  messages  Message[]
  reviews   Review[]
}

model Category {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  title    String
  sort     Int       @default(0)
  products Product[]
}

enum DeliveryType {
  MANUAL // админ выдаёт руками (Premium подарком, подписки на аккаунт)
  CODES // код из загруженного склада выдаётся автоматически
}

enum Glass {
  RED
  WHITE
  DARK
}

/// Как выдаём: без входа в аккаунт покупателя или со входом.
/// Два товара с одинаковым названием и разным режимом показываются одной карточкой с вкладками.
enum AccessMode {
  UNSPECIFIED // не показываем покупателю
  NO_LOGIN // без входа: по @username, подарком, кодом
  WITH_LOGIN // со входом в аккаунт покупателя
  GIFT // подарком на @username
}

/// Что спрашиваем у покупателя при заказе (если needsRecipient)
enum RecipientKind {
  USERNAME // @username в Telegram
  PHONE // номер телефона аккаунта, для выдачи со входом
  STEAM // логин Steam, для пополнения
}

model Product {
  id             Int           @id @default(autoincrement())
  categoryId     Int
  category       Category      @relation(fields: [categoryId], references: [id])
  title          String
  subtitle       String        @default("")
  description    String        @default("")
  icon           String        @default("star") // имя глифа в мини-аппе
  glass          Glass         @default(RED)
  deliveryType   DeliveryType  @default(MANUAL)
  needsRecipient Boolean       @default(true) // спрашивать ли получателя (что именно — recipientKind)
  recipientKind  RecipientKind @default(USERNAME)
  access         AccessMode    @default(UNSPECIFIED)
  wholesale      Boolean       @default(false) // вариант «Опт»: покупатель пишет в поддержку
  isActive       Boolean       @default(true)
  isHit          Boolean       @default(false)
  sort           Int           @default(0)
  createdAt      DateTime      @default(now())
  variants       Variant[]
  reviews        Review[]
}

model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title     String // «12 мес», «500 Stars»
  price     Int // цена продажи
  oldPrice  Int? // зачёркнутая цена
  cost      Int     @default(0) // закупка, для маржи (у perUnit — за единицу)
  /// Своё количество: покупатель вводит число единиц (звёзды, рубли Steam), price и cost — за единицу
  perUnit   Boolean @default(false)
  unit      String  @default("") // «Stars», «₽ на Steam»
  minQty    Int     @default(1)
  maxQty    Int     @default(1)
  isActive  Boolean @default(true)
  sort      Int     @default(0)
  codes     Code[]
  orders    Order[]
}

model Code {
  id        Int       @id @default(autoincrement())
  variantId Int
  variant   Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value     String
  orderId   Int?      @unique
  order     Order?    @relation(fields: [orderId], references: [id])
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

enum OrderStatus {
  PENDING_PAYMENT // ждём оплату
  AWAITING_CONFIRMATION // ручная оплата: клиент прислал чек, ждём админа
  PAID // оплачено, в очереди выдачи
  DELIVERED
  REJECTED // админ отклонил ручную оплату
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CRYPTOBOT
  XROCKET
  LOLZ
  SBP
  UAH
  BALANCE
}

model Order {
  id            Int           @id @default(autoincrement())
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  variantId     Int
  variant       Variant       @relation(fields: [variantId], references: [id])
  recipient     String?
  status        OrderStatus   @default(PENDING_PAYMENT)
  method        PaymentMethod
  amount        Int // итог к оплате в копейках RUB
  cost          Int           @default(0) // закупка на момент заказа
  quantity      Int           @default(1) // число единиц для варианта со своим количеством
  promoCode     String?
  discount      Int           @default(0)
  payAmount     String? // сумма в валюте оплаты строкой («1250.00 UAH», «36.12 USDT»)
  externalId    String? // id инвойса у провайдера
  payUrl        String?
  proofFileId   String? // file_id скриншота оплаты в Telegram
  deliveredText String? // что выдали клиенту (код, комментарий)
  createdAt     DateTime      @default(now())
  paidAt        DateTime?
  deliveredAt   DateTime?
  code          Code?
  messages      Message[]
  review        Review?

  @@index([status])
  @@index([userId])
}

/// Отзыв покупателя: один на заказ, только по выданному заказу.
model Review {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int // 1..5
  text       String   @default("")
  isHidden   Boolean  @default(false) // админ убрал с витрины
  editCount  Int      @default(0) // сколько раз покупатель правил отзыв
  activityAt DateTime @default(now()) // создан или последний раз изменён покупателем: по нему сортирует админка
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([productId, isHidden])
  @@index([createdAt])
  @@index([activityAt])
}

model Message {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  fromAdmin Boolean  @default(false)
  text      String
  fileId    String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model PromoCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  amount    Int       @default(0) // фиксированная скидка
  percent   Int       @default(0)
  usesLeft  Int?
  expiresAt DateTime?
}

/// Настройки магазина ключ-значение (карта для UAH, курсы, комиссии, включённые методы).
model Setting {
  key   String @id
  value Json
}
