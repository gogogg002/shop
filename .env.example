# База
DATABASE_URL=postgresql://vault:vault@db:5432/vault
POSTGRES_PASSWORD=vault

# Бот: токен от @BotFather и ваш Telegram ID (узнать: @userinfobot). Несколько админов через запятую.
BOT_TOKEN=
ADMIN_IDS=

# Публичный https-адрес сервера. На него указывает кнопка бота и вебхуки платёжек.
PUBLIC_URL=https://shop.example.com

# Платёжки (пусто = метод выключен)
CRYPTOBOT_TOKEN=
CRYPTOBOT_TESTNET=false
XROCKET_TOKEN=
LOLZ_TOKEN=

# Только для локальной разработки: вход без Telegram через ?dev=<tgId>. В проде false!
DEV_AUTH=false
